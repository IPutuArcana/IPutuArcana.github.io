---
// The stage the VRM character is rendered into. Markup only — everything that
// moves lives in `src/scripts/lionk.ts`, which is what decides whether the
// 15 MB model is worth downloading for this visitor at all.
//
// The stage itself never takes pointer events, so the deck underneath keeps
// working normally; only the small toggle button is clickable.
---

<div class="lionk-stage" data-lionk aria-hidden="true">
  <div class="lionk-burst">
    <i class="lionk-burst-ring"></i>
    <i class="lionk-burst-bar"></i>
    <i class="lionk-burst-bar"></i>
  </div>
  <canvas class="lionk-canvas" data-lionk-canvas></canvas>
  <p class="lionk-status" data-lionk-status hidden></p>

  <button type="button" class="lionk-toggle" data-lionk-toggle aria-pressed="true" hidden>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
      <circle cx="12" cy="8.5" r="3.6" stroke="currentColor" stroke-width="1.6"></circle>
      <path
        d="M4.8 20c.6-3.9 3.6-6 7.2-6s6.6 2.1 7.2 6"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"></path>
    </svg>
  </button>
</div>

<style>
  .lionk-stage {
    position: fixed;
    right: 0;
    bottom: 0;
    height: 100dvh;
    width: clamp(20rem, 27vw, 30rem);
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 1.4s var(--ease-out-expo),
      transform 1.4s var(--ease-out-expo);
  }

  /* Set by the script once the model is on screen. */
  .lionk-stage[data-ready='true'] {
    opacity: 1;
    transform: none;
  }

  .lionk-canvas {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  /* The graphic hit that lands behind the character when the slide changes:
     a ring punching outward and two speed bars raking past. Fired by lionk.ts
     via `.is-burst` on the stage. */
  .lionk-burst {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .lionk-burst i {
    position: absolute;
    display: block;
    opacity: 0;
  }

  .lionk-burst-ring {
    top: 50%;
    left: 50%;
    width: 16rem;
    height: 16rem;
    margin: -8rem 0 0 -8rem;
    border: 3px solid var(--color-accent);
    border-radius: 50%;
  }

  .lionk-burst-bar {
    left: -20%;
    right: -20%;
    height: 0.5rem;
    background: var(--color-accent);
    transform: skewY(-8deg);
  }

  .lionk-burst-bar:nth-of-type(2) {
    top: 34%;
  }

  .lionk-burst-bar:nth-of-type(3) {
    top: 62%;
    height: 0.25rem;
  }

  .lionk-stage.is-burst .lionk-burst-ring {
    animation: lionk-ring 620ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .lionk-stage.is-burst .lionk-burst-bar {
    animation: lionk-bar 520ms cubic-bezier(0.72, 0, 0.16, 1) both;
  }

  .lionk-stage.is-burst .lionk-burst-bar:nth-of-type(3) {
    animation-delay: 80ms;
  }

  @keyframes lionk-ring {
    0% {
      opacity: 0.75;
      transform: scale(0.25);
    }
    100% {
      opacity: 0;
      transform: scale(1.35);
    }
  }

  @keyframes lionk-bar {
    0% {
      opacity: 0.85;
      transform: skewY(-8deg) translateX(-115%);
    }
    100% {
      opacity: 0;
      transform: skewY(-8deg) translateX(115%);
    }
  }

  .lionk-stage[data-off='true'] .lionk-canvas,
  .lionk-stage[data-off='true'] .lionk-status {
    display: none;
  }

  .lionk-status {
    position: absolute;
    inset-inline: 0;
    bottom: 3.4rem;
    text-align: center;
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    opacity: 0.75;
  }

  .lionk-toggle {
    position: absolute;
    right: var(--space-md);
    /* Stacked above the back-to-top FAB, which owns the bottom-right corner. */
    bottom: calc(var(--space-md) + 3.75rem);
    pointer-events: auto;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: var(--rule-width) solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    color: var(--color-text-muted);
    opacity: 0.45;
    transition:
      opacity var(--duration-fast) var(--ease-out-expo),
      color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo);
  }

  .lionk-toggle:hover,
  .lionk-toggle:focus-visible {
    opacity: 1;
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .lionk-stage[data-off='true'] {
    opacity: 1;
    transform: none;
    width: 6rem;
  }

  /* The stage only makes sense once there is room beside the deck content —
     this matches the MIN_VIEWPORT guard in the script. */
  @media (max-width: 1099px) {
    .lionk-stage {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lionk-stage {
      display: none;
    }
  }
</style>

<script src="../scripts/lionk.ts"></script>
